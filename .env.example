# --- Veritabanı (lokal: docker compose up -d db) ---
DATABASE_URL=postgres://sector7:sector7@localhost:5432/sector7
# Entegrasyon testleri bu veritabanını kullanır ve her koşuda sıfırlar.
DATABASE_URL_TEST=postgres://sector7:sector7@localhost:5432/sector7_test

# --- Oturum ---
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=degistir-beni-en-az-32-karakter-rastgele-bir-dizi
# Uygulamanın dışarıdan erişilen adresi (tek kullanımlık bağlantılar bu adresle üretilir)
APP_URL=http://localhost:3000

# --- Dosya yüklemeleri ---
UPLOAD_DIR=./uploads

# --- Seed / ilk ana yönetici (yalnız db:seed ve admin:create okur) ---
SEED_ADMIN_USERNAME=kurucu
SEED_ADMIN_NAME=Kurucu
SEED_ADMIN_EMAIL=kurucu@example.com
SEED_ADMIN_PASSWORD=

# --- Web Push (isteğe bağlı; boşsa push kapalı) ---
# Anahtar üret: npm run push:keys  (çıktıyı buraya yapıştır)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- GitHub hesap bağlama (isteğe bağlı; ikisi de doluysa entegrasyon açık, ticket kabulü için bağlı hesap zorunlu) ---
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: <APP_URL>/api/auth/callback/github  (Better Auth baseURL = APP_URL)
# Scope yalnız read:user; token saklanmaz. Adım 2'de GitHub App'e geçilecek.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App senkronu (Aşama 7.5; isteğe bağlı; aşağıdakilerin HEPSİ ve özel anahtar doluysa açık) ---
# Kurulum: GitHub org → Settings → Developer settings → GitHub Apps → New GitHub App; org'a kur (yalnız ilgili depolar).
# Repository izinleri: Issues: Read & write · Pull requests: Read-only · Contents: Read & write · Metadata: Read-only
# Webhook: Active; URL = <APP_URL>/api/github/webhook; Secret = GITHUB_WEBHOOK_SECRET; olaylar: Pull request, Issues
# Kurulumdan sonra Installation ID adres çubuğundaki /installations/<ID> kısmıdır.
# Depolar org içinde önceden açılır; Ana yönetici panelinden (Alanlar) alanlara atanır.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=
# Özel anahtar (PEM): ya satır sonları "\n" kaçışlı tek satır ya da dosya yolu (ikisinden biri)
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
